#!/bin/sh
set -eu

stage=0

repo_root=$(git rev-parse --show-toplevel)
commit=$(git -C "$repo_root" rev-parse HEAD)
tmp_root=$(mktemp -d "${TMPDIR:-/tmp}/zorcerer-pre-push.XXXXXX")
worktree="$tmp_root/worktree"

stageMsg() {
    printf '[Zorcerer] Stage %s: %s\n' "$stage" "$*"
}

ensureSuccess() {
    if "$@"; then
        stage=$((stage + 1))
    else
        status=$?
        printf '[Zorcerer] Stage %s failed (exit code %s).\n' \
            "$stage" "$status" >&2
        return "$status"
    fi
}

clearGitEnv() {
    for name in $(git -C "$repo_root" rev-parse --local-env-vars); do
        unset "$name"
    done
}

cleanup() {
    git -C "$repo_root" worktree remove --force "$worktree" \
        >/dev/null 2>&1 || true
    rm -rf "$tmp_root"
}

prepare() {
    clearGitEnv
    git -C "$repo_root" worktree add \
        --quiet --detach "$worktree" "$commit"
}

runZigTests() {
    (
        cd "$worktree" &&
        zig build tests </dev/null
    )
}

trap cleanup 0

stageMsg "Preparation"
ensureSuccess prepare

stageMsg "Zig tests for commit $commit"
ensureSuccess runZigTests

printf '[Zorcerer] All %s stages passed.\n' "$stage"
