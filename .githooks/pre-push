#!/bin/sh
# Zorcerer pre-push hook: test every pushed commit in a clean worktree.
#
# Reads the refs git feeds the hook on stdin ("<local ref> <local oid>
# <remote ref> <remote oid>" per line) and runs `zig build tests` against
# each unique pushed commit, so broken code can never reach the remote —
# even when pushing branches other than the current one.
#
# Design notes:
#   * Uncommitted changes are never tested: commits are checked out into a
#     temporary worktree, mirroring exactly what will land on the remote.
#   * Branch deletions (all-zero oids — works for both SHA-1 and SHA-256
#     repositories) are skipped; several refs pointing at the same commit
#     are tested once.
#   * Local dependency storage is reused: every submodule recorded under
#     `extern/` in the pushed commit is relinked (leaf-level symlink) into
#     the test worktree after each checkout. The path components above the
#     submodule leaves stay real directories, because git refuses any
#     symlinked component that leads to a submodule ("expected '...' in
#     submodule path '...' not to be a symbolic link"). A leaf whose target
#     is missing from the main checkout is linked anyway; the test build
#     then fails on the absent dependency sources instead of fetching them.
#   * Submodules are never cloned, initialized, updated, or fetched inside
#     the temporary worktree: a commit's submodule oids are compared against
#     whatever the developer has checked out, never pulled.
#   * The test build runs in the background with `wait`, so signal traps
#     (HUP/INT/TERM) fire immediately and cleanup is never deferred until
#     the build finishes.
#   * The hook itself uses no positional parameters, so `set --` is safe.
#   * Requires: git >= 2.5 (worktree), zig on PATH.

set -eu

stage=1
total=0
zig_pid=
tmp_root=
worktree=

stageMsg() {
    printf '[Zorcerer] Stage %s/%s: %s\n' "$stage" "$total" "$*"
}

ensureSuccess() {
    if "$@"; then
        stage=$((stage + 1))
    else
        status=$?
        printf '[Zorcerer] Stage %s/%s failed (exit code %s).\n' \
            "$stage" "$total" "$status" >&2
        return "$status"
    fi
}

clearGitEnv() {
    for name in $(git -C "$repo_root" rev-parse --local-env-vars); do
        unset "$name"
    done
}

# Keep the developer's zig cache overrides from leaking into the clean test
# run (they could silently reuse the main checkout's build cache).
clearZigEnv() {
    unset ZIG_GLOBAL_CACHE_DIR ZIG_LOCAL_CACHE_DIR ZIG_LIB_DIR \
        ZIG_HOMEDIR_CACHE
}

cleanup() {
    if [ -n "$zig_pid" ]; then
        kill "$zig_pid" 2>/dev/null || true
        wait "$zig_pid" 2>/dev/null || true
    fi
    if [ -n "$worktree" ]; then
        # Removes the worktree's shared links (leaf symlinks) before removal.
        # `rm -rf` unlinks symlinks without following them into the main
        # checkout's dependency directories.
        rm -rf "$worktree/extern"
        git -C "$repo_root" worktree remove --force "$worktree" \
            >/dev/null 2>&1 || true
    fi
    if [ -n "$tmp_root" ]; then
        rm -rf "$tmp_root"
    fi

    git -C "$repo_root" worktree prune >/dev/null 2>&1 || true
}

prepare() {
    if [ ! -d "$repo_root/extern" ]; then
        printf '[Zorcerer] %s/extern not found.\n' "$repo_root" >&2
        return 1
    fi

    git -C "$repo_root" worktree add \
        --quiet --detach "$worktree" "$first_oid" || return $?
}

# Subdir of the gitlink path; dirname(1) is portable enough for paths like
# extern/zig-toml, and the worktree checkout materializes all directories
# above the submodule leaves anyway.
linkSharedExtern() {
    local name
    git -C "$worktree" ls-tree -r -z HEAD |
        tr '\0' '\n' |
        awk -F '\t' '$1 ~ /^160000 commit / && $2 ~ /^extern\// {print $2}' |
        while IFS= read -r name; do
            [ -n "$name" ] || continue
            mkdir -p "$worktree/$(dirname "$name")"
            rm -rf "$worktree/$name"
            ln -s "$repo_root/$name" "$worktree/$name"
        done
}

testCommit() {
    # $1 = pushed commit oid. --force discards build residue (.zig-cache,
    # zig-out, ...) that could otherwise block the next checkout.
    git -C "$worktree" checkout --detach --force --quiet "$1" || return $?

    # Re-link the shared dependency sources: checkout materializes each
    # recorded submodule path as an empty real directory (replacing the
    # leaf symlink from the previous test), so the leaves are re-created
    # against the new commit's submodule list. Path components above the
    # leaves stay real directories, as git requires for submodule paths.
    linkSharedExtern || return $?

    # Run in background + wait so trapped signals are handled immediately;
    # `exec` makes the subshell become zig itself, so $! is zig's pid.
    #
    # -Dskip-analyze=true: skips building the Clang/LLVM-based analyzer and
    # its configure-time data regeneration. The hook must not require system
    # Clang/LLVM development packages, and a clean worktree has no analyzer
    # binary to regenerate with; the module tests still run.
    (
        cd "$worktree" &&
        exec zig build tests -Dskip-analyze=true </dev/null
    ) &
    zig_pid=$!
    wait "$zig_pid"
    rc=$?
    zig_pid=
    return "$rc"
}

repo_root=$(git rev-parse --show-toplevel)

if ! command -v zig >/dev/null 2>&1; then
    printf '[Zorcerer] zig not found in PATH; cannot run tests.\n' >&2
    exit 1
fi

if [ -t 0 ]; then
    printf '[Zorcerer] This hook expects pre-push stdin; invoke it via git push.\n' >&2
    exit 1
fi

clearGitEnv
clearZigEnv

# Collect unique local oids of every pushed ref. Skips deletions (all-zero
# oid) regardless of hash algorithm; dedups refs sharing one commit.
pushed_oids=
pushed_list=
while read -r _local_ref oid _remote_ref _remote_oid; do
    case "$oid" in
        *[!0]*) ;;        # a real oid
        *) continue ;;    # all zeros -> ref deletion, nothing to test
    esac
    case "$pushed_oids" in
        *" $oid "*) continue ;;
    esac
    pushed_oids="$pushed_oids $oid "
    pushed_list="$pushed_list$oid $_local_ref
"
done

set -- $pushed_oids
oid_count=$#
if [ "$oid_count" -eq 0 ]; then
    printf '[Zorcerer] Nothing to test (deletion-only or empty push).\n'
    exit 0
fi
first_oid=$1

total=$((oid_count + 1))

tmp_root=$(mktemp -d "${TMPDIR:-/tmp}/zorcerer-pre-push.XXXXXX")
worktree="$tmp_root/worktree"

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

stageMsg "Preparation"
ensureSuccess prepare

while read -r oid ref; do
    [ -n "$oid" ] || continue
    stageMsg "Testing $(git -C "$repo_root" rev-parse --short "$oid") ($ref)"
    ensureSuccess testCommit "$oid"
done <<EOF
$pushed_list
EOF

printf '[Zorcerer] All %s stages passed.\n' "$total"
